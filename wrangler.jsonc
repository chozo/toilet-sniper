{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toilet-sniper",
  "compatibility_date": "2026-10-21",
  "workers_dev": false,
  "preview_urls": false,
  // npm run build で dist/toilet-sniper/ に出力する。公開URLは https://game.chozo.net/toilet-sniper/
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    {"pattern": "game.chozo.net/toilet-sniper", "zone_name": "chozo.net"},
    {"pattern": "game.chozo.net/toilet-sniper/*", "zone_name": "chozo.net"}
  ]
}
