{
  "name": "toilet-sniper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5195",
    "dev:lan": "vite --host 0.0.0.0 --port 5195",
    "build": "rm -rf dist && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5196",
    "test": "vitest run",
    "e2e": "node tools/e2e.mjs",
    "ogp": "node tools/ogp/make-ogp.mjs",
    "promo": "npm run build && node tools/promo/record.mjs",
    "shots": "node tools/shots.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wrangler": "^4.151.3"
  }
}
